app/.env

# git worktrees for parallel agents; `git worktree` places them inside the repo
.claude/worktrees/

# One developer's additions to the workspace lifecycle. .superset/config.json is shared and
# committed; this file is not.
.superset/config.local.json

# python venv for services/verifier
.venv/
__pycache__/
*.egg-info/
