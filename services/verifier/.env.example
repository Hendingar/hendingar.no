# Azure OpenAI account endpoint — Entra auth, no API key. This is the real dev account.
AZURE_OPENAI_ENDPOINT=https://aoai-hendingar-qr5hsiu33zals.openai.azure.com/

# The Azure *deployment* name, not a catalogue model id. Must be a vision-capable deployment:
# poster extraction sends an image. gpt-4.1-mini works; Mistral-Large-3 is text-only.
AZURE_OPENAI_CHAT_MODEL=gpt-4.1-mini

# Set by Container Apps to pin the user-assigned managed identity. Unset locally, where
# DefaultAzureCredential falls back to `az login`.
# AZURE_CLIENT_ID=

# Local only. Name the tenant if your `az login` covers more than one, otherwise you get a token
# for whichever subscription is active and a 401 that does not say why. Nordlo tenant:
AZURE_TENANT_ID=c23b3840-812e-4067-9bdb-a3eb446c5892

LOG_LEVEL=INFO

# TypeSafe's Jev, which ranks /haugen (ADR 0022). The one key in this service — TypeSafe has no
# Entra auth. Leave unset and /haugen answers 503; the app then falls back to matching text.
# Create one at https://console.typesafe.ai/. Never commit it.
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_SECONDS=3
