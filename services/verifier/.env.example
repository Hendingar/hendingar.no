# Azure AI Foundry (or Azure OpenAI) account endpoint — Entra auth, no API key.
AZURE_OPENAI_ENDPOINT=https://ai-hendingar-xxxx.cognitiveservices.azure.com/

# The Azure *deployment* name, not a catalogue model id. Must be a vision-capable deployment:
# poster extraction sends an image. gpt-4.1-mini works; Mistral-Large-3 is text-only.
AZURE_OPENAI_CHAT_MODEL=gpt-4.1-mini

# Set by Container Apps to pin the user-assigned managed identity. Unset locally, where
# DefaultAzureCredential falls back to `az login`.
# AZURE_CLIENT_ID=

LOG_LEVEL=INFO
