{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": false,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "scripts/**/*.ts", "drizzle.config.ts", "test/**/*.ts"]
}
