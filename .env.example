# Local development. Start the database with `pnpm db:up`.
#
# Port 5433, not 5432: other projects commonly hold 5432, and a silent collision shows up as a
# confusing authentication failure against someone else's database.
#
# 127.0.0.1, not localhost: Apple's `container` runtime publishes the port on IPv4 only, while
# Node 22 resolves `localhost` verbatim and reaches for ::1 first. The failure is an ECONNRESET
# from drizzle-kit with no mention of IPv6, which is a long way to walk for a one-word fix.
DATABASE_URL=postgres://hendingar:hendingar@127.0.0.1:5433/hendingar

# Optional. The verifier microservice (services/verifier) that does photo extraction and
# agentic verification. Without it those features are disabled and the form still works.
# Run it locally with: cd services/verifier && uv run verifier serve
# VERIFIER_URL=http://localhost:8080

# Normally leave this alone. `pnpm db:pull` reads the Postgres admin password from Key Vault,
# where every deploy writes it, so it does not belong in a file on your laptop — you need `az login`
# and the Key Vault Secrets User role instead (infra/BOOTSTRAP.md).
#
# Set it only to override the vault: a password that has been rotated but not yet redeployed, or an
# environment with no vault yet.
# POSTGRES_ADMIN_PASSWORD=
